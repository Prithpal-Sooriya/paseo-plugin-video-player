{
  "name": "paseo-plugin-video-player",
  "version": "0.1.1",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "client/",
    "server/",
    "shared/",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:mobile": "! grep -rnE 'document\\.|window\\.|localStorage|navigator\\.|className=|onClick=' client/ --include=*.tsx",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run check:mobile && npm run check:package"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "description": "Paseo plugin: play video files (MP4, MOV, WebM) inside Paseo file tabs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prithpal-Sooriya/paseo-plugin-video-player.git"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "video",
    "mp4"
  ]
}
